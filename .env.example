# Copy to .env. Nothing here is required to try the app locally: without a bucket, photos are
# saved in ./data/files and the photo list in ./data/album.db.
# `npm run qr` and `npm run download` read the codes below, so keep them matching the live
# album (where they're Fly secrets, see README).

# Guests need this to get in. It's built into the QR code; keep it short, e.g. ALEXSAM27.
# Leave empty for an album anyone with the link can use.
GUEST_CODE=

# Visit /?code=<ADMIN_CODE> for admin mode (remove any photo). Make it long and secret,
# e.g. the output of `openssl rand -hex 12`.
ADMIN_CODE=

# Optional
# MAX_UPLOAD_MB=50
# PORT=8080
# DATA_DIR=./data

# Only needed to try a real bucket locally. On Fly, `fly storage create` sets these for you.
# BUCKET_NAME=
# AWS_ENDPOINT_URL_S3=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=auto
